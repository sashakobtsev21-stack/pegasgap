# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (см. .gitignore).

# --- Доступ к JSON-шлюзу Слетать (module.sletat.ru) ---
# Логин и пароль от личного кабинета Слетать. Шлюз принимает их GET-параметрами — это его
# контракт; в логи URL уходит с вырезанными значениями.
# Без этих переменных проверяемая сторона читается браузером (запасной путь).
SLETAT_LOGIN=
SLETAT_PASSWORD=

# --- Чем читать проверяемую сторону ---
# api | web. По умолчанию api, если заданы доступы выше, иначе web.
# Явное значение полезно, чтобы осознанно сверить один запрос обоими путями.
# PEGASGAP_SLETAT_SOURCE=api

# --- Пределы прогона ---
# PEGASGAP_PROVIDER_TIMEOUT_S=180   # жёсткий таймаут на площадку
# PEGASGAP_PROVIDER_RETRIES=1       # повторов при случайном сбое
# PEGASGAP_MAX_HOTELS=300           # предохранитель от бесконечной ленты (браузерный путь)
# PEGASGAP_API_PAGE_SIZE=1000       # размер страницы выдачи шлюза
# PEGASGAP_API_POLL_TIMEOUT_S=120   # сколько ждать завершения всех операторов

# --- Логи ---
# PEGASGAP_LOG_FORMAT=json
